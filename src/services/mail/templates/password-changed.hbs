<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Password Changed - PePP Cruise</title>
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8fafc;
        margin: 0;
        padding: 20px;
      }
      .container {
        background-color: #ffffff;
        margin: 50px auto;
        padding: 30px;
        max-width: 600px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(95, 61, 244, 0.1);
      }
      .header {
        text-align: center;
        background: linear-gradient(135deg, #5f3df4, #4c2cc7);
        color: #ffffff;
        padding: 25px 0;
        border-radius: 12px 12px 0 0;
        margin: -30px -30px 30px -30px;
      }
      .header h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 600;
      }
      .brand-name {
        font-size: 18px;
        margin-bottom: 5px;
        opacity: 0.9;
      }
      .content {
        padding: 0 10px;
      }
      .content p {
        line-height: 1.6;
        color: #4a5568;
        margin: 15px 0;
      }
      .greeting {
        font-size: 18px;
        color: #1a202c;
        font-weight: 500;
      }
      .success-notice {
        background-color: #f0f9ff;
        border-left: 4px solid #10b981;
        padding: 20px;
        border-radius: 8px;
        margin: 25px 0;
      }
      .success-notice p {
        margin: 5px 0;
        color: #065f46;
      }
      .info-box {
        background-color: #f7fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 20px;
        margin: 25px 0;
      }
      .info-box p {
        margin: 10px 0;
        font-size: 14px;
      }
      .security-warning {
        background-color: #fef5e7;
        border-left: 4px solid #f6ad55;
        padding: 15px 20px;
        border-radius: 8px;
        margin: 20px 0;
      }
      .security-warning p {
        margin: 5px 0;
        color: #744210;
      }
      .footer {
        text-align: center;
        font-size: 14px;
        color: #718096;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
      }
      .footer .signature {
        color: #5f3df4;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <div class='brand-name'>PePP Cruise</div>
        <h1>🔒 Password Successfully Changed</h1>
      </div>

      <div class='content'>
        <p class='greeting'>Hello {{fullName}},</p>

        <p>
          Your password has been successfully changed for your PePP Cruise
          account.
        </p>

        <div class='success-notice'>
          <p><strong>✅ Change Confirmed:</strong></p>
          <p>Your password was changed on {{changedAt}}</p>
        </div>

        <div class='info-box'>
          <p><strong>Account Details:</strong></p>
          <p>Email: {{email}}</p>
        </div>

        <div class='security-warning'>
          <p><strong>🔐 Security Notice:</strong></p>
          <p>If you did not change your password, please contact our support
            team immediately.</p>
        </div>

        <p>
          For security reasons, if you did not request this change, please:</p>
        <ul>
          <li>Contact our support team at
            <a
              href='mailto:support@peppcruise.com'
              style='color: #5F3DF4; text-decoration: none;'
            >
              support@peppcruise.com
            </a>
          </li>
          <li>Reset your password immediately</li>
          <li>Review your account security settings</li>
        </ul>

        <p>
          Keep your password secure and never share it with anyone.
        </p>
      </div>

      <div class='footer'>
        <p>Best regards,</p>
        <p class='signature'>The PePP Cruise Security Team</p>
        <p style='margin-top: 15px; font-size: 12px;'>
          © 2024 PePP Cruise. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>