<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Tutor Invitation — Nugi Innovations</title>
    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
      You’ve been invited to join Nugi Innovations as a Tutor. Use the link below to sign in and complete your account setup.
    </div>

    <style>
      :root{
        --ni-bg:#fbfbfa;
        --ni-card:#ffffff;
        --ni-accent:#d9b44a;
        --ni-accent-deep:#b8862b;
        --ni-muted:#6b6b6b;
        --ni-text:#1f1f1f;
        --ni-border:rgba(184,134,11,0.08);
        --ni-shadow:rgba(184,134,11,0.12);
      }

      *{box-sizing:border-box;margin:0;padding:0}
      img{display:block;max-width:100%;border:0}
      body{
        background-color:var(--ni-bg);
        font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
        -webkit-text-size-adjust:100%;
        color:var(--ni-text);
        padding:36px 16px;
      }

      .wrapper{width:100%;background-color:var(--ni-bg)}
      .container{
        max-width:600px;margin:0 auto;background:var(--ni-card);
        border-radius:14px;overflow:hidden;box-shadow:0 18px 48px var(--ni-shadow);
        border:1px solid var(--ni-border);
      }

      .header{
        background:linear-gradient(135deg, rgba(217,180,74,0.08) 0%, rgba(217,180,74,0.04) 100%);
        padding:40px 28px;text-align:center;
      }
      .brand-mark{
        display:inline-block;width:56px;height:56px;line-height:56px;border-radius:12px;
        background:rgba(217,180,74,0.08);border:1px solid rgba(217,180,74,0.12);
        font-size:20px;font-weight:800;color:var(--ni-accent-deep);text-align:center;margin-bottom:12px;
      }
      .brand-label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--ni-muted);font-weight:700;margin-bottom:8px}
      .header h1{color:var(--ni-accent-deep);font-size:26px;font-weight:800;line-height:1.2}
      .header-subtitle{margin-top:10px;color:var(--ni-muted);font-size:14px;line-height:1.6}

      .content{padding:32px 28px 28px}
      .greeting{font-size:20px;font-weight:700;color:var(--ni-text);margin-bottom:12px}
      .body-text{font-size:15px;line-height:1.7;color:var(--ni-muted);margin-bottom:14px}

      .invite-card{
        margin:22px 0;border-radius:12px;overflow:hidden;border:1px solid var(--ni-border);
        background:linear-gradient(180deg,#fffdf9 0%, rgba(217,180,74,0.03) 100%);
      }
      .invite-card-strip{
        padding:12px 16px;background:linear-gradient(90deg, rgba(217,180,74,0.06), rgba(217,180,74,0.02));
        display:flex;align-items:center;gap:8px;
      }
      .strip-label{font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--ni-accent-deep)}
      .invite-card-body{padding:12px 16px 16px}

      /* layout for label/value pairs */
      .detail-row{
        display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;
        border-bottom:1px solid rgba(184,134,11,0.04);
      }
      .detail-row:last-child{border-bottom:none;padding-bottom:0}

      /* label on left, value on right; ensure visible spacing */
      .detail-left{display:flex;align-items:center;gap:10px;min-width:0}
      .detail-label{
        color:var(--ni-muted);font-size:13px;font-weight:600;white-space:nowrap;
      }
      .detail-value{
        color:var(--ni-text);font-size:13.5px;font-weight:700;text-align:right;word-break:break-word;
        margin-left:12px;
      }

      .password-pill{
        display:inline-block;padding:6px 10px;border-radius:8px;background:rgba(217,180,74,0.06);
        color:var(--ni-accent-deep);font-weight:700;font-family:"SFMono-Regular","Fira Code",monospace;
      }

      .button-wrapper{text-align:center;margin:26px 0 18px}
      .cta-button{
        display:inline-block;background:linear-gradient(90deg,var(--ni-accent) 0%,var(--ni-accent-deep) 100%);
        color:#1f1f1f !important;text-decoration:none;padding:12px 34px;border-radius:10px;
        font-size:15px;font-weight:700;box-shadow:0 10px 28px rgba(184,134,11,0.12);
      }

      .fallback-section{margin-top:16px;border-radius:10px;border:1px dashed rgba(184,134,11,0.06);background:#fffdf8;overflow:hidden}
      .fallback-header-bar{padding:8px 14px;border-bottom:1px solid rgba(184,134,11,0.04);font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--ni-accent-deep);background:rgba(217,180,74,0.02)}
      .fallback-body{padding:12px 14px 14px}
      .fallback-intro{font-size:13px;color:var(--ni-muted);margin-bottom:10px;line-height:1.5}
      .url-row{display:flex;align-items:stretch;gap:10px}
      .url-masked-wrap{flex:1;min-width:0;background:#fff;border:1px solid #efe7d0;border-radius:8px;padding:8px 12px;display:flex;align-items:center;overflow:hidden}
      .url-masked-text{font-family:"SFMono-Regular","Fira Code",monospace;font-size:12px;color:var(--ni-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;max-width:100%}
      .url-copy-btn{display:inline-block;flex-shrink:0;padding:9px 14px;border-radius:8px;background:linear-gradient(90deg,var(--ni-accent) 0%,var(--ni-accent-deep) 100%);color:#1f1f1f !important;text-decoration:none;font-size:13px;font-weight:700}
      .fallback-note{margin-top:10px;font-size:12px;color:#8a8570;line-height:1.5}

      .notice{margin-top:18px;padding:14px 16px;border-left:4px solid rgba(217,180,74,0.6);background:#fffaf0;border-radius:0 8px 8px 0}
      .notice p{font-size:13px;line-height:1.6;color:#6b4f1a}
      .closing{margin-top:18px;font-size:15px;line-height:1.7;color:var(--ni-muted);padding-bottom:28px}

      .footer{border-top:1px solid #f3ecd0;background:linear-gradient(180deg,#fffaf6 0%,#fff7e9 100%);padding:20px 24px 28px;text-align:center}
      .footer-regards{font-size:14px;color:#7a6b4a;margin-bottom:6px}
      .footer-team{font-size:15px;font-weight:800;color:var(--ni-accent-deep);margin-bottom:0}
      .footer-copy{font-size:12px;color:#9a8f72;margin-top:10px}

      @media screen and (max-width:600px){
        body{padding:16px 8px}
        .container{border-radius:12px}
        .header{padding:28px 18px}
        .header h1{font-size:22px}
        .content{padding:22px 18px 16px}
        .cta-button{display:block;padding:12px 18px}
        .detail-row{flex-direction:column;align-items:flex-start;gap:8px}
        .detail-value{text-align:left;margin-left:0}
        .url-row{flex-direction:column;gap:10px}
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <div class="header">
          <div class="brand-mark">NI</div>
          <div class="brand-label">Nugi Innovations</div>
          <h1>Tutor Invitation</h1>
          <p class="header-subtitle">You’ve been invited to join Nugi Innovations as a Tutor. Sign in to get started.</p>
        </div>

        <div class="content">
          <p class="greeting">Hello {{firstName}},</p>

          <p class="body-text">
            Welcome to <strong>Nugi Innovations</strong>. An account has been created for you as a Tutor. Use the link below to sign in and complete your profile.
          </p>

          <div class="invite-card">
            <div class="invite-card-strip">
              <span class="strip-label">Account details</span>
            </div>

            <div class="invite-card-body">
              <div class="detail-row">
                <div class="detail-left">
                  <span class="detail-label">Email</span>
                </div>
                <div>
                  <span class="detail-value">{{email}}</span>
                </div>
              </div>

              <div class="detail-row">
                <div class="detail-left">
                  <span class="detail-label">Temporary password</span>
                </div>
                <div>
                  <span class="detail-value"><span class="password-pill">{{temporaryPassword}}</span></span>
                </div>
              </div>

              <div class="detail-row">
                <div class="detail-left">
                  <span class="detail-label">Sign in</span>
                </div>
                <div>
                  <span class="detail-value">{{loginUrl}}</span>
                </div>
              </div>
            </div>
          </div>

          <div class="button-wrapper">
            <a href="{{loginUrl}}" class="cta-button">Sign in and complete setup →</a>
          </div>

          <div class="fallback-section">
            <div class="fallback-header-bar">If the button doesn't work</div>
            <div class="fallback-body">
              <p class="fallback-intro">Click the link below to open the sign-in page in your browser.</p>

              <div class="url-row">
                <div class="url-masked-wrap">
                  <span class="url-masked-text">{{loginUrl}}</span>
                </div>
                <a href="{{loginUrl}}" class="url-copy-btn">Open link</a>
              </div>

              <p class="fallback-note">For security, this temporary password should be changed after your first sign-in.</p>
            </div>
          </div>

          <div class="notice">
            <p><strong>Security note:</strong> This email contains a temporary password. If you did not expect this invitation, please ignore this message or contact your administrator.</p>
          </div>

          <p class="closing">We’re glad to have you on board. If you need help, reach out to your Nugi Innovations administrator.</p>
        </div>

        <div class="footer">
          <p class="footer-regards">Best regards,</p>
          <p class="footer-team">Nugi Innovations</p>
          <p class="footer-copy">© Nugi Innovations. All rights reserved.</p>
        </div>
      </div>
    </div>
  </body>
</html>
