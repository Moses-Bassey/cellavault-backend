<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>New Login Detected - PePP Cruise</title>
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8fafc;
        margin: 0;
        padding: 20px;
      }
      .container {
        background-color: #ffffff;
        margin: 50px auto;
        padding: 30px;
        max-width: 600px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(95, 61, 244, 0.1);
      }
      .header {
        text-align: center;
        background: linear-gradient(135deg, #5f3df4, #4c2cc7);
        color: #ffffff;
        padding: 25px 0;
        border-radius: 12px 12px 0 0;
        margin: -30px -30px 30px -30px;
      }
      .header h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 600;
      }
      .brand-name {
        font-size: 18px;
        margin-bottom: 5px;
        opacity: 0.9;
      }
      .content {
        padding: 0 10px;
      }
      .content p {
        line-height: 1.6;
        color: #4a5568;
        margin: 15px 0;
      }
      .greeting {
        font-size: 18px;
        color: #1a202c;
        font-weight: 500;
      }
      .login-info {
        background-color: #f7fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 20px;
        margin: 25px 0;
      }
      .login-info p {
        margin: 10px 0;
        font-size: 14px;
      }
      .info-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #e2e8f0;
      }
      .info-row:last-child {
        border-bottom: none;
      }
      .info-label {
        color: #718096;
        font-weight: 600;
      }
      .info-value {
        color: #2d3748;
      }
      .security-warning {
        background-color: #fef5e7;
        border-left: 4px solid #f6ad55;
        padding: 15px 20px;
        border-radius: 8px;
        margin: 20px 0;
      }
      .security-warning p {
        margin: 5px 0;
        color: #744210;
      }
      .footer {
        text-align: center;
        font-size: 14px;
        color: #718096;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
      }
      .footer .signature {
        color: #5f3df4;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <div class='brand-name'>PePP Cruise</div>
        <h1>🔐 New Login Detected</h1>
      </div>

      <div class='content'>
        <p class='greeting'>Hello {{fullName}},</p>

        <p>
          We detected a new login to your PePP Cruise account. If this was you, you can safely ignore this email.
        </p>

        <div class='login-info'>
          <p style='margin-bottom: 15px; font-weight: 600; color: #5F3DF4;'>Login Details:</p>
          
          <div class='info-row'>
            <span class='info-label'>Device:</span>
            <span class='info-value'>{{deviceInfo}}</span>
          </div>
          
          <div class='info-row'>
            <span class='info-label'>Time:</span>
            <span class='info-value'>{{loginTime}}</span>
          </div>
          
          {{#if ipAddress}}
          <div class='info-row'>
            <span class='info-label'>IP Address:</span>
            <span class='info-value'>{{ipAddress}}</span>
          </div>
          {{/if}}
        </div>

        <div class='security-warning'>
          <p><strong>⚠️ Security Notice:</strong></p>
          <p>If you did not make this login attempt, please take immediate action:</p>
          <ul style='margin: 10px 0; padding-left: 20px;'>
            <li>Change your password immediately</li>
            <li>Review your account activity</li>
            <li>Contact us at 
              <a href='mailto:support@peppcruise.com' style='color: #5F3DF4; text-decoration: none;'>
                support@peppcruise.com
              </a>
            </li>
          </ul>
        </div>

        <p>
          For your security, we monitor all login attempts to your account and notify you of new devices or locations.
        </p>

        <p>
          If you have any questions or concerns, please don't hesitate to contact our support team.
        </p>
      </div>

      <div class='footer'>
        <p>Best regards,</p>
        <p class='signature'>The PePP Cruise Security Team</p>
        <p style='margin-top: 15px; font-size: 12px;'>
          © 2024 PePP Cruise. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>

