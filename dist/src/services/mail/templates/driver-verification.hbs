<html>
  <head>
    <meta charset='utf-8' />
    <title>Driver Verification Update - PeppCruise</title>
    <style
    >
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background-color: {{#if
        (eq verificationStatus 'approved')
      }}#28a745{{else}}#dc3545{{/if}}; color: white; padding: 20px; text-align: center; }
        .content { padding: 20px; background-color: #f9f9f9; }
        .status { padding: 15px; border-radius: 5px; margin: 15px 0; }
        .approved { background-color: #d4edda; border: 1px solid #c3e6cb; color: #155724; }
        .rejected { background-color: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; }
        .footer { text-align: center; padding: 20px; color: #666; font-size: 12px; }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h1>{{#if (eq verificationStatus 'approved')}}✅ Driver Approved{{else}}❌
            Driver Verification Update{{/if}}</h1>
      </div>
      <div class='content'>
        <h2>Hello {{fullName}},</h2>

        <div class='status {{verificationStatus}}'>
          {{#if (eq verificationStatus 'approved')}}
            <h3>🎉 Congratulations! Your driver application has been approved!</h3>
            <p>You can now start accepting ride requests and earning money with
              PeppCruise.</p>
          {{else}}
            <h3>Driver Application Update</h3>
            <p>Unfortunately, your driver application was not approved at this
              time.</p>
            {{#if reason}}
              <p><strong>Reason:</strong> {{reason}}</p>
            {{/if}}
            <p>You can reapply after addressing the issues mentioned above.</p>
          {{/if}}
        </div>

        {{#if (eq verificationStatus 'approved')}}
          <p>Next steps:</p>
          <ul>
            <li>Complete your driver profile</li>
            <li>Upload required documents</li>
            <li>Start accepting rides</li>
          </ul>
        {{else}}
          <p>If you have any questions about this decision, please contact our
            support team.</p>
        {{/if}}

        <p>Thank you for your interest in joining PeppCruise!</p>
        <p><strong>The PeppCruise Team</strong></p>
      </div>
      <div class='footer'>
        <p>Need help? Contact our support team at support@peppcruise.com</p>
      </div>
    </div>
  </body>
</html>