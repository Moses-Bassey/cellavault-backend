<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Welcome to PePP Cruise</title>
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8fafc;
        margin: 0;
        padding: 20px;
      }
      .container {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 12px;
        max-width: 600px;
        margin: 0 auto;
        box-shadow: 0 4px 20px rgba(95, 61, 244, 0.1);
        text-align: center;
      }
      .header {
        border-bottom: 2px solid #5f3df4;
        padding-bottom: 20px;
        margin-bottom: 30px;
      }
      .logo {
        max-width: 120px;
        margin-bottom: 10px;
      }
      .brand-name {
        color: #5f3df4;
        font-size: 24px;
        font-weight: bold;
        margin: 0;
      }
      h1 {
        color: #1a202c;
        font-size: 28px;
        margin: 20px 0;
      }
      p {
        color: #4a5568;
        line-height: 1.6;
        text-align: left;
        margin: 15px 0;
      }
      .highlight-box {
        background-color: #f7fafc;
        border-left: 4px solid #5f3df4;
        padding: 20px;
        margin: 25px 0;
        border-radius: 8px;
      }
      .cta-button {
        display: inline-block;
        background-color: #5f3df4;
        color: white;
        text-decoration: none;
        padding: 15px 30px;
        border-radius: 8px;
        font-weight: 600;
        margin-top: 25px;
        font-size: 16px;
        transition: background-color 0.3s ease;
      }
      .cta-button:hover {
        background-color: #4c2cc7;
      }
      .footer {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
        font-size: 14px;
        color: #718096;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h2 class='brand-name'>PePP Cruise</h2>
      </div>

      <h1>🎉 You're Invited to Join PePP Cruise</h1>

      <p>
        Hello! Welcome to the <strong>PePP Cruise</strong> platform.
      </p>

      <p>
        To complete your sign-up, please use the One-Time Password (OTP) below to verify your email address and activate your account.
      </p>

      <div style="text-align:center; margin: 24px 0;">
        <span style="display: inline-block; background-color: #F3F2FD; color: #2A239F; font-size: 22px; font-weight: bold; letter-spacing: 4px; padding: 14px 28px; border-radius: 12px;">
          {{otpCode}}
        </span>
      </div>

      <p>
        This OTP will expire on <strong>{{expiryDate}}</strong>. Please enter it on the verification page to complete your registration.
      </p>

        <p>
          If you did not request this code, you can safely ignore this email.
        </p>

        <div class="footer">
          <p>Best regards,<br />The PePP Cruise Team</p>
          <p>
            Need help? <a href="mailto:support@peppcruise.com" style="color:#5F3DF4;">Contact our support team</a>.
          </p>
        </div>

    </div>
  </body>
</html>